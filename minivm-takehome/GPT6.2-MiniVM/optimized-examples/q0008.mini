LOAD    o_qty, orders.o_qty
LOAD    o_status, orders.o_status
GE      f, o_qty, 5
IDX     w_w, f
GATHER  w_o_qty, o_qty, w_w
GATHER  w_o_status, o_status, w_w
NULLIFE xk, w_o_status
RTRIM   k_t, xk
UPPER   k, k_t
GROUP   g, k
GMIN    rep, g, xk                 ; one spelling per group
GCOUNT  a0, g
GSUM    a1, g, w_o_qty
LEFT    sk_l, rep, 10
RTRIM   sk_t, sk_l
UPPER   sk, sk_t
SORT    q, a0 DESC NL, sk ASC NF
GATHER  o_rep, rep, q
GATHER  o_a0, a0, q
GATHER  o_a1, a1, q
OUT     o_rep, o_a0, o_a1
